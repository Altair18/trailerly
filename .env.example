# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trailerly

# Claude: brief, hooks, timelines, frame checks
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini API: Veo 3.1 Lite (social) and Fast (header/search)
GEMINI_API_KEY=
VEO_MODEL_LITE=veo-3.1-lite
VEO_MODEL_FAST=veo-3.1-fast

# fal: fallback video model (Kling or Hailuo) and upscaling
FAL_KEY=
FAL_FALLBACK_MODEL=
FAL_UPSCALE_MODEL=

# Voice (ElevenLabs or Google Cloud TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Background jobs
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PACK=

# Pack economics (pence)
PACK_PRICE_PENCE=1900
PACK_COST_BUDGET_PENCE=700

# Optional: path to a Chrome headless shell for local Remotion renders
REMOTION_BROWSER_EXECUTABLE=

# Errors
SENTRY_DSN=
